# Host-run OpenClaw gateway environment
# Copy to /etc/openclaw/openclaw-gateway.env and lock permissions down.

# Gateway bind/port
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_GATEWAY_PORT=18789

# Required gateway auth
OPENCLAW_GATEWAY_TOKEN=replace-with-long-random-token

# Optional gateway flags
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# Research relay
RESEARCH_RELAY_ENABLED=true
RESEARCH_UPSTREAM_URL=http://100.96.107.87:8787
RESEARCH_SHARED_TOKEN=replace-with-worker-shared-token
RESEARCH_ACTOR_ID=jarvis.vps
RESEARCH_REQUEST_TIMEOUT_SEC=15
RESEARCH_EXPERIMENT_EXECUTE_TIMEOUT_SEC=1800
RESEARCH_MAX_TOPIC_LEN=500
RESEARCH_MAX_LABEL_LEN=100

# Optional web auth/session material
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# State locations for this VPS layout
OPENCLAW_HOME=/home/saifeel/.openclaw
OPENCLAW_STATE_DIR=/home/saifeel/.openclaw
